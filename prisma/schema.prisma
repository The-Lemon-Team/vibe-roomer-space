generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}



model User {
  id              String           @id @default(uuid())
  email           String           @unique
  username        String           @unique
  password        String
  role            Role             @default(USER)
  vibes           Vibe[]
  rooms           Room[]
  roomStreamItems RoomStreamItem[]
  roomNews        RoomNews[]
  roomNotes       RoomNote[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Vibe {
  id          String          @id @default(uuid())
  title       String          // e.g., "Cyber-Coffee & Heavy Code"
  content     String          @db.Text
  keywords    String[]        // ["lofi", "nestjs", "night", "junkpunk"]
  
  // media content for the post
  images      String[]
  videoUrls   String[]
  musicUrls   String[]

  // placeholder for future "Atmospheric Rooms" functionality
  roomConfig  Json?           // JSON with settings (bg textures, neon colors)
  
  inMainFeed  Boolean         @default(false)
  authorId    String
  author      User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  updates     VibeUpdate[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model VibeUpdate {
  id        String   @id @default(uuid())
  content   String   @db.Text
  mediaUrls String[]
  vibeId    String
  vibe      Vibe     @relation(fields: [vibeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Hashtag {
  id          String   @id @default(uuid())
  name        String   @unique
  useCount    Int      @default(1)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
}

model Room {
  id              String           @id @default(uuid())
  title           String
  description     String?          @db.Text
  poster          String?
  originVibeId    String?
  isPublic        Boolean          @default(true)
  tags            String[]
  images          String[]
  videoUrls    String[]
  musicUrls    String[]
  youtubeUrls  String[]
  roomConfig      Json?
  authorId        String
  author          User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  streamItems     RoomStreamItem[]
  news            RoomNews[]
  notes           RoomNote[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RoomStreamItem {
  id        String   @id @default(uuid())
  type      String
  content   String?  @db.Text
  mediaUrls String[]
  url       String?
  title     String?
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model RoomNews {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model RoomNote {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text // Markdown text
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
