# ─── Vibe Roomer — Production Environment ───────────────────────────────────
# Copy to .env on your server and fill in ALL values marked with CHANGE_ME.
# NEVER commit this file with real credentials.

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Supabase → Settings → Database → Connection String
#
# Session pooler (port 5432 via PgBouncer) — used for all runtime Prisma queries
DATABASE_URL="postgresql://postgres.CHANGE_ME_project_ref:CHANGE_ME_password@aws-0-CHANGE_ME_region.pooler.supabase.com:5432/postgres"

# Direct connection — used ONLY by prisma migrate deploy at container startup
DIRECT_URL="postgresql://postgres.CHANGE_ME_project_ref:CHANGE_ME_password@db.CHANGE_ME_project_ref.supabase.co:5432/postgres"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64

# File uploads directory (no longer used — Supabase Storage handles uploads in production)
# UPLOADS_DIR=./uploads

# ── Supabase Storage ──────────────────────────────────────────────────────────
# Supabase → Settings → API → Project URL
SUPABASE_URL=https://CHANGE_ME_project_ref.supabase.co
# Supabase → Settings → API → service_role secret key
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_service_role_key
# Name of the public storage bucket created in Supabase Dashboard
SUPABASE_STORAGE_BUCKET=media

# CORS — set to your exact frontend origin(s)
# e.g. CORS_ORIGIN=https://viber.yourdomain.com
CORS_ORIGIN=https://CHANGE_ME_your_domain.com

# ── Client / Nginx ────────────────────────────────────────────────────────────
# In production behind Nginx the client talks to /api (proxied internally)
VITE_API_URL=/api

# Host port that Nginx listens on (80 for HTTP, 443 if you terminate TLS here)
FRONTEND_PORT=80
