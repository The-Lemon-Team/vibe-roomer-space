{
  "name": "vibe-roomer-server",
  "version": "1.0.0",
  "description": "NestJS Backend for Vibe Roomer",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --watch --require @swc-node/register src/main.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/src/generated', { recursive: true }); fs.cpSync('src/generated', 'dist/src/generated', { recursive: true, force: false, errorOnExist: false });\"",
    "start": "node --require @swc-node/register src/main.ts",
    "start:dev": "node --watch --require @swc-node/register src/main.ts",
    "start:prod": "node dist/main.js",
    "start:migrate": "prisma migrate deploy && node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "seed": "node --require @swc-node/register prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node --require @swc-node/register prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^6.3.0",
    "@supabase/supabase-js": "^2.111.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^6.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
