generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ActivityContext {
  WORK
  WALK
  NIGHT_DRIVE
  RELAX
  SPORT
  CUSTOM
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  role      Role     @default(USER)
  vibes     Vibe[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vibe {
  id          String          @id @default(uuid())
  title       String
  content     String          @db.Text
  keywords    String[]
  activity    ActivityContext @default(CUSTOM)
  
  images      String[]
  videoUrl    String?
  musicUrl    String?

  roomConfig  Json?
  
  inMainFeed  Boolean         @default(false)
  authorId    String
  author      User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  updates     VibeUpdate[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model VibeUpdate {
  id        String   @id @default(uuid())
  content   String   @db.Text
  mediaUrls String[]
  vibeId    String
  vibe      Vibe     @relation(fields: [vibeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Hashtag {
  id          String   @id @default(uuid())
  name        String   @unique
  useCount    Int      @default(1)
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
}
