# ─── Vibe Roomer — Production (Internal Postgres) ────────────────────────────
# Copy to .env on your server and fill in ALL values marked with CHANGE_ME.
# NEVER commit this file with real credentials.

# ── Database (internal postgres container) ───────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password
POSTGRES_DB=viberoomer

# ── Server ────────────────────────────────────────────────────────────────────
MEDIA_PROVIDER=local
PORT=3001
NODE_ENV=production
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64

# Local disk storage path inside the container/app host.
UPLOADS_DIR=./uploads

# Unsplash image search (https://unsplash.com/oauth/applications)
UNSPLASH_ACCESS_KEY="TminNoUKwNucUryiEMf1n2U8_ajAcj7Wk6Wz_tW5DBc"

# ── Frontend / CORS ───────────────────────────────────────────────────────────
CORS_ORIGIN=https://CHANGE_ME_your_domain.com
VITE_API_URL=/api
FRONTEND_PORT=80
