{
  "name": "vibe-roomer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "client:dev": "vite",
    "client:test": "vitest run",
    "client:build": "tsc && vite build",
    "client:preview": "vite preview",
    "server": "npm --prefix server run start:dev",
    "server:dev": "npm --prefix server run start:dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server run start",
    "server:prod": "npm --prefix server run start:prod",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "npm --prefix server run seed",
    "prod:build": "bash scripts/build.sh",
    "prod:deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "@reduxjs/toolkit": "^2.12.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-player": "^3.4.0",
    "react-redux": "^9.3.0",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.1",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  }
}
