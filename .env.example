# ─── Vibe Roomer — Localhost Development Environment ────────────────────────
# Copy this to .env (repo root) to run fully on localhost:
#   cp .env.example .env
#   npm run db:up
#   npm run db:push
#
# Stack: local PostgreSQL (docker compose) + local disk uploads.
# For the Supabase variant, use .env.supabase.example instead.

# ── Database (localhost Postgres via `npm run db:up`) ─────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5448/viberoomer?schema=public"
# Optional: only needed when using a pooled Supabase URL + prisma migrate.
# DIRECT_URL="postgresql://postgres:postgres@localhost:5448/viberoomer?schema=public"

# ── Server ────────────────────────────────────────────────────────────────────
MEDIA_PROVIDER="local"
PORT=3001
NODE_ENV=development
JWT_SECRET="super-secret-vibe-key-change-in-production"
UPLOADS_DIR="./uploads"

# CORS allowed origin ('*' = allow all, set to your domain in production)
CORS_ORIGIN="*"

# Unsplash image search (https://unsplash.com/oauth/applications)
# Free Access Key — required for Unsplash search in the UI
UNSPLASH_ACCESS_KEY="TminNoUKwNucUryiEMf1n2U8_ajAcj7Wk6Wz_tW5DBc"

# ── Client (Vite) ─────────────────────────────────────────────────────────────
VITE_API_URL="http://localhost:3001"
