# ─── Vibe Roomer — Development Environment ──────────────────────────────────
# Copy this to .env and fill in values before running locally.

# ── Database (Supabase) ───────────────────────────────────────────────────────
# Supabase → Settings → Database → Connection String
#
# Session pooler (port 5432 via PgBouncer) — used for all runtime queries
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Direct connection — used ONLY for Prisma migrations (prisma migrate deploy/dev)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# JWT secret (change to a long random string in production)
JWT_SECRET="super-secret-vibe-key-change-in-production"

# File uploads directory (relative to server working directory)
UPLOADS_DIR="./uploads"

# CORS allowed origin ('*' = allow all, set to your domain in production)
CORS_ORIGIN="*"

# ── Client (Vite) ─────────────────────────────────────────────────────────────
# Base URL the browser uses to reach the API
# In development: full backend URL
# In production (Docker/Nginx): use '/api' — Nginx proxies it
VITE_API_URL="http://localhost:3001"
